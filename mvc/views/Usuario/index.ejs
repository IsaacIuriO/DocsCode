<!DOCTYPE html>

<html lang="pt-br">

    <head>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>DocsCode</title>

        <!-- Bootstrap -->
        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

        <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Rubik", sans-serif;
                background-color: #130B2E;
                color: white;

                min-height: 100vh;

                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;

                padding: 30px 20px;
            }

            /* Área principal */
            .content {
                width: 100%;
                max-width: 900px;

                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;

                gap: 35px;
            }

            /* Logo */
            .logo img {
                width: min(300px, 70vw);
                height: auto;
            }

            /* Texto */
            .text1 {
                display: flex;
                flex-direction: column;
                align-items: center;

                gap: 15px;
            }

            .text1 h1 {
                font-size: clamp(2rem, 5vw, 3.5rem);
                margin: 0;
            }

            .text1 a {
                text-decoration: none;
                color: #30e47e;

                font-size: clamp(1.2rem, 3vw, 2rem);

                transition: 0.2s ease;
            }

            .text1 a:hover {
                color: #5ff29b;
            }

            /* Celular */
            @media (max-width: 576px) {

                body {
                    padding: 20px;
                }

                .content {
                    gap: 25px;
                }

                .logo img {
                    width: min(250px, 75vw);
                }

                .text1 {
                    gap: 10px;
                }

            }

        </style>

    </head>

    <body>

        <main class="content">

            <div class="logo">
                <img src="/imgs/docscode_logo.png" alt="Logo DocsCode">
            </div>

            <div class="text1">

                <h1>Bem-Vindo!</h1>

                <a href="/usuario/criar">
                    Iniciar Conversa
                </a>

            </div>

        </main>

    </body>

</html>
