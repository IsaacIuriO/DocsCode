<!-- conversa.ejs -->

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DocsCode AI</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background-color: #100e12;
            font-family: 'Poppins', sans-serif;
            color: white;
            overflow: hidden;
        }

        /* Barra lateral */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 248px;
            height: 100vh;
            background-color: #1c172c;
            display: flex;
            flex-direction: column;
            padding: 15px 8px 10px;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 10px 22px;
        }

        /* Logo */

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 500;
            letter-spacing: -0.4px;
        }

        .imagem-container {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .imagem-container img {
            width: 100%;
            height: auto;
        }

        /* Menu lateral */
        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 100%;
            padding: 12px 15px;
            border-radius: 7px;
            color: #dedede;
            text-decoration: none;
            font-size: 14px;
            font-weight: 400;
            transition: background-color 0.2s, color 0.2s;
        }

        .menu-item i {
            font-size: 19px;
        }

        .menu-item:hover {
            background-color: #3f316e;
        }

        /* Títulos das seções */
        .section-label {
            color: #aaa;
            font-size: 13px;
            padding: 24px 9px 10px;
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-right: 8px;
        }

        .history-header .section-label {
            padding-top: 22px;
        }

        /* Histórico */
        .history-item {
            display: block;
            padding: 11px 9px;
            color: #dedede;
            text-decoration: none;
            font-size: 13px;
            border-radius: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: background-color 0.2s, color 0.2s;
        }

        .history-item:hover {
            background-color: #3f316e;
        }

        /* Perfil inferior */

        .sidebar-footer {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 7px 3px;
        }

        /* Perfil */
        .avatar {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #51afe3, #7460dc);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 17px;
        }

        .profile-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .profile-name {
            font-size: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-plan {
            color: #aaa;
            font-size: 11px;
        }

        .icons-button {
            background: transparent;
            border: none;
            color: #ccc;
            font-size: 18px;
            padding: 5px;
            transition: background-color 0.2s, color 0.2s;
        }

        .icons-button:hover {
            color: #51afe3;
        }


        /* Área principal */

        main {
            margin-left: 248px;
            height: 100vh;
            position: relative;
            display: flex;
            flex-direction: column;
            background-color: #100e12;
        }

        /* Brilho azulado de fundo */

        main::before {
            content: "";
            position: absolute;
            width: 650px;
            height: 500px;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -43%);
            background: radial-gradient(
                ellipse,
                rgba(59, 38, 150, 0.36) 0%,
                rgba(26, 37, 115, 0.22) 40%,
                rgba(16, 14, 18, 0) 72%
            );
            pointer-events: none;
        }

        /* Conteúdo central */

        .chat-area {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            padding-bottom: 100px;
        }

        /* Título central */
        .titulo {
            font-size: 38px;
            font-weight: 400;
            color: #e5e2ec;
            text-align: center;
            margin-bottom: 38px;
            letter-spacing: -1.2px;
            line-height: 1.3;
        }

        /* Área do formulário */
        .prompt-container {
            width: 100%;
            max-width: 680px;
        }

        /* Caixa de mensagem */
        .prompt-box {
            min-height: 68px;
            width: 100%;
            background-color: #222124;
            border: 1px solid #343139;
            border-radius: 35px;
            padding: 12px 17px;
            display: flex;
            align-items: center;
            gap: 13px;
            transition: border-color 0.2s, background-color 0.2s,
                        box-shadow 0.2s;
        }

        .prompt-box:focus-within {
            border-color: #51afe3;
            background-color: #252329;
            box-shadow: 0 0 0 3px rgba(81, 175, 227, 0.08);
        }
        
        /* Botão de adicionar */

        .prompt-icon {
            background: transparent;
            border: none;
            color: #e0e0e0;
            font-size: 25px;
            padding: 5px;
            min-width: 38px;
            min-height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

        .prompt-icon:hover {
            color: #51afe3;
        }

        /* Campo de texto */
        .prompt-input {
            flex: 1;
            min-width: 0;
            background: transparent;
            border: none;
            outline: none;
            color: white;
            font-family: 'Poppins', sans-serif;
            font-size: 16px;

            padding: 12px 12px 12px 2px;
        }

        .prompt-input::placeholder {
            color: #c4c2c8;
        }

        /* Botão de envio */
        .send-button {
            display: none;
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 50%;
            background-color: #51afe3;
            color: #100e12;
            font-size: 19px;
            transition: background-color 0.2s, transform 0.2s;
        }

        .send-button:hover {
            background-color: #8acdf2;
            transform: scale(1.04);
        }

        /* Aviso abaixo da caixa */
        .prompt-hint {
            color: #99959f;
            font-size: 12px;
            text-align: center;
            margin-top: 16px;
        }


        /* Mensagens de exemplo */

        .suggestions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .suggestion {
            padding: 12px 18px;
            min-height: 46px;
            border: 1px solid #393640;
            background-color: rgba(34, 33, 36, 0.8);
            color: #d4d1dc;
            border-radius: 25px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            cursor: pointer;
            transition: border-color 0.2s, color 0.2s,
                        background-color 0.2s, transform 0.2s;
        }

        .suggestion i {
            font-size: 16px;
            margin-right: 5px;
        }

        .suggestion:hover {
            border-color: #51afe3;
            color: white;
            background-color: #252329;
            transform: translateY(-2px);
        }


        /* Responsividade */

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: 270px;
                box-shadow: 10px 0 30px rgba(0, 0, 0, 0.3);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            main {
                margin-left: 0;
            }

            .chat-area {
                padding: 25px 22px;
                padding-bottom: 60px;
            }

            .titulo {
                font-size: 32px;
                margin-bottom: 30px;
            }

            .prompt-container {
                max-width: 600px;
            }

            main::before {
                width: 100%;
                height: 400px;
            }
        }

        @media (max-width: 480px) {
            .chat-area {
                padding: 20px 15px;
                padding-bottom: 40px;
            }

            .titulo {
                font-size: 27px;
                margin-bottom: 25px;
                letter-spacing: -0.7px;
            }

            .prompt-box {
                min-height: 60px;
                padding: 9px 11px;
                gap: 7px;
            }

            .prompt-input {
                font-size: 14px;
            }

            .prompt-icon {
                font-size: 21px;
                min-width: 32px;
                min-height: 32px;
            }

            .send-button {
                width: 38px;
                height: 38px;
            }

            .prompt-hint {
                font-size: 11px;
                padding: 0 8px;
            }

            .suggestions {
                gap: 9px;
                margin-top: 24px;
            }

            .suggestion {
                font-size: 12px;
                padding: 10px 13px;
                min-height: 42px;
            }
        }

    </style>
</head>

<body>

    <!-- Barra lateral -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-header">

            <div class="logo">
                <div class="imagem-container">
                    <img src="/imgs/docscode_logo.png" alt="Logo DocsCode">
                </div>
                <span>DocsCode AI</span>
            </div>

            <button class="icons-button" title="Configurações">
                <i class="bi bi-search"></i>
            </button>

        </div>


        <!-- Menu principal -->
        <nav class="menu">

            <a href="#" class="menu-item active">
                <i class="bi bi-pencil-square"></i>
                <span>Nova conversa</span>
            </a>

            <a href="#" class="menu-item">
                <i class="bi bi-grid"></i>
                <span>Uploads</span>
            </a>

        </nav>


        <!-- Histórico -->
        <div class="history-header">
            <span class="section-label">Todas</span>
        </div>

        <a href="#" class="history-item">
            Projeto de Desenvolvimento
        </a>


        <!-- Perfil -->
        <div class="sidebar-footer">

            <div class="avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="profile-info">
                <div class="profile-name"><%= username || 'Visitante' %></div>
                <div class="profile-plan">Plano Gratuito</div>
            </div>

            <button class="icons-button" title="Configurações">
                <i class="bi bi-gear"></i>
            </button>

        </div>

    </aside>

    <!-- Área principal -->
    <main>

        <!-- Conteúdo central -->
        <section class="chat-area">

            <h1 class="titulo">Compartilhe comigo tuas ideias.</h1>

            <div class="prompt-container">

                <form class="prompt-box" id="chatForm">

                    <button type="button" class="prompt-icon"
                            title="Adicionar arquivo">
                        <i class="bi bi-plus-lg"></i>
                    </button>

                    <input
                        type="text"
                        class="prompt-input"
                        id="promptInput"
                        placeholder="Peça algo à DocsCode AI..."
                        autocomplete="off"
                    >

                    <button type="submit" class="send-button"
                            id="sendButton" title="Enviar mensagem">
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <p class="prompt-hint">
                    A IA pode falhar ou gerar informações incorretas.
                </p>

            </div>

            <!-- Sugestões -->
            <div class="suggestions">

                <button class="suggestion" data-prompt="Me ajude a programar">
                    <i class="bi bi-code-slash"></i>
                    Programar
                </button>

                <button class="suggestion" data-prompt="Me ajude a produzir um documento">
                    <i class="bi bi-book"></i>
                    Documentar
                </button>

                <button class="suggestion" data-prompt="Explique este código">
                    <i class="bi bi-lightbulb"></i>
                    Explicar código
                </button>

            </div>

        </section>

    </main>

    <script>

        const sidebar = document.getElementById('sidebar');
        const promptInput = document.getElementById('promptInput');
        const chatForm = document.getElementById('chatForm');
        const sendButton = document.getElementById('sendButton');

        // Mostrar o botão de envio quando houver texto
        promptInput.addEventListener('input', () => {
            sendButton.style.display =
                promptInput.value.trim() ? 'flex' : 'none';
        });

        // Preencher o campo pelas sugestões
        document.querySelectorAll('.suggestion').forEach(button => {
            button.addEventListener('click', () => {
                promptInput.value = button.dataset.prompt;
                promptInput.dispatchEvent(new Event('input'));
                promptInput.focus();
            });
        });

        // Envio demonstrativo
        chatForm.addEventListener('submit', event => {
            event.preventDefault();

            const mensagem = promptInput.value.trim();

            if (!mensagem) return;

            alert(
                'Mensagem: ' + mensagem +
                '\n\nConecte uma API de IA para receber respostas.'
            );

            promptInput.value = '';
            promptInput.dispatchEvent(new Event('input'));
        });

    </script>

</body>
</html>
