<!-- conversa.ejs -->

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DocsCode AI</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg: #100e16;
            --sidebar-bg: #171321;
            --sidebar-hover: #2b2142;
            --surface: #201d29;
            --surface-hover: #292431;
            --border: #393344;
            --text: #f5f2fb;
            --muted: #aaa4b8;
            --accent: #8b6cff;
            --accent-light: #b5a2ff;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            overflow: hidden;
            background: var(--bg);
            color: var(--text);
            font-family: "Poppins", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button,
        input {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        /* Barra lateral */
        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            width: var(--sidebar-width);
            height: 100dvh;
            padding: 20px 12px 14px;
            overflow-x: hidden;
            overflow-y: auto;
            background: var(--sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.045);
            transition: transform 0.28s ease;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 0 7px 28px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: -0.5px;
            white-space: nowrap;
        }

        .imagem-container {
            display: flex;
            flex: 0 0 40px;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
        }

        .imagem-container img {
            display: block;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .icons-button {
            display: inline-flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            padding: 0;
            color: #c9c3d4;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 11px;
            cursor: pointer;
            transition: color 0.2s ease, background 0.2s ease,
                border-color 0.2s ease;
        }

        .icons-button:hover {
            color: #fff;
            background: var(--sidebar-hover);
            border-color: rgba(181, 162, 255, 0.18);
        }

        .icons-button i {
            font-size: 17px;
        }

        /* Menu lateral */
        .menu {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 13px;
            width: 100%;
            min-height: 46px;
            padding: 11px 13px;
            color: #d6d0e0;
            text-decoration: none;
            font-size: 13px;
            font-weight: 400;
            border: 1px solid transparent;
            border-radius: 12px;
            transition: background 0.2s ease, color 0.2s ease,
                border-color 0.2s ease;
        }

        .menu-item i {
            font-size: 18px;
        }

        .menu-item:hover,
        .menu-item.active {
            color: #fff;
            background: var(--sidebar-hover);
        }

        .menu-item.active {
            border-color: rgba(181, 162, 255, 0.12);
        }

        /* Histórico */
        .history-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 24px;
            padding: 0 10px;
        }

        .section-label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .history-item {
            display: block;
            margin-top: 8px;
            padding: 11px 12px;
            overflow: hidden;
            color: #d2ccdc;
            text-decoration: none;
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
            border: 1px solid transparent;
            border-radius: 10px;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .history-item:hover {
            color: #fff;
            background: var(--sidebar-hover);
        }

        /* Perfil inferior */
        .sidebar-footer {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: auto;
            padding: 16px 5px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .avatar {
            display: flex;
            flex: 0 0 38px;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            color: white;
            font-size: 17px;
            background: linear-gradient(135deg, #8b6cff, #4f8de8);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50%;
        }

        .profile-info {
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 0;
            gap: 3px;
        }

        .profile-name {
            overflow: hidden;
            color: #f4f0fb;
            font-size: 12px;
            font-weight: 500;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-plan {
            color: var(--muted);
            font-size: 10px;
        }

        /* Painel de configurações */
        .configbar {
            position: fixed;
            inset: 0 auto 0 var(--sidebar-width);
            z-index: 1100;
            display: flex;
            flex-direction: column;
            width: min(320px, calc(100vw - var(--sidebar-width)));
            height: 100dvh;
            padding: 22px 18px;
            overflow-y: auto;
            background: #171321;
            border-right: 1px solid var(--border);
            box-shadow: 18px 0 45px rgba(0, 0, 0, 0.25);
        }

        .configbar[hidden] {
            display: none !important;
        }

        .configbar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 24px;
        }

        .configbar-header h2 {
            margin: 0;
            color: var(--text);
            font-size: 20px;
            font-weight: 500;
            letter-spacing: -0.5px;
        }

        .configbar-content {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .configbar-item {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
            padding: 11px 12px;
            overflow: hidden;
            background-color:#171321;
            color: #d2ccdc;
            text-decoration: none;
            font-size: 14px;
            text-align: left;
            text-overflow: ellipsis;
            white-space: nowrap;
            border: 1px solid transparent;
            border-radius: 10px;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .configbar-item#logoutButton {
            color: #ff0000;
        }

        button.configbar-item:hover {
            color: #fff;
            background: var(--sidebar-hover);
        }

        /* Área principal */
        main {
            position: relative;
            display: flex;
            flex-direction: column;
            width: calc(100% - var(--sidebar-width));
            height: 100dvh;
            margin-left: var(--sidebar-width);
            overflow: hidden;
            background:
                radial-gradient(ellipse at 52% 42%,
                    rgba(89, 62, 174, 0.16) 0%,
                    rgba(37, 29, 65, 0.08) 35%,
                    transparent 68%),
                var(--bg);
        }

        main::before {
            position: absolute;
            top: 50%;
            left: 50%;
            width: min(760px, 90%);
            height: 560px;
            content: "";
            pointer-events: none;
            transform: translate(-50%, -48%);
            background: radial-gradient(
                ellipse,
                rgba(112, 78, 220, 0.15) 0%,
                rgba(65, 54, 135, 0.08) 42%,
                transparent 72%
            );
        }

        /* Conteúdo central */
        .chat-area {
            position: relative;
            z-index: 1;
            display: flex;
            flex: 1;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 0;
            padding: 36px 28px 70px;
        }

        .titulo {
            max-width: 760px;
            margin: 0 0 34px;
            color: #f3effb;
            font-size: clamp(28px, 3vw, 40px);
            font-weight: 400;
            line-height: 1.3;
            letter-spacing: -1.3px;
            text-align: center;
            text-wrap: balance;
        }

        /* Campo de mensagem */
        .prompt-container {
            width: 100%;
            max-width: 720px;
        }

        .prompt-box {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            min-height: 70px;
            padding: 10px 13px;
            background: rgba(32, 29, 41, 0.92);
            border: 1px solid #3c354b;
            border-radius: 22px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
            transition: border-color 0.2s ease, background 0.2s ease,
                box-shadow 0.2s ease;
        }

        .prompt-box:focus-within {
            background: #24202f;
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(139, 108, 255, 0.12),
                0 14px 42px rgba(0, 0, 0, 0.18);
        }

        .prompt-icon {
            display: flex;
            flex: 0 0 40px;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            padding: 0;
            color: #d4cde2;
            font-size: 22px;
            background: transparent;
            border: 0;
            border-radius: 12px;
            cursor: pointer;
            transition: color 0.2s ease, background 0.2s ease;
        }

        .prompt-icon:hover {
            color: white;
            background: #393047;
        }

        .prompt-input {
            flex: 1;
            min-width: 0;
            padding: 12px 2px;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            background: transparent;
            border: 0;
            outline: none;
        }

        .prompt-input::placeholder {
            color: #a9a2b7;
            opacity: 1;
        }

        .send-button {
            display: none;
            flex: 0 0 42px;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            color: #fff;
            font-size: 19px;
            background: var(--accent);
            border: 0;
            border-radius: 14px;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
        }

        .send-button:hover {
            background: #a18aff;
            transform: translateY(-1px);
        }

        .prompt-hint {
            margin: 13px 0 0;
            padding: 0 8px;
            color: #8f899d;
            font-size: 11px;
            line-height: 1.6;
            text-align: center;
        }

        /* Sugestões */
        .suggestions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 27px;
        }

        .suggestion {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 43px;
            padding: 10px 15px;
            color: #d9d2e7;
            font-family: inherit;
            font-size: 12px;
            background: rgba(32, 29, 41, 0.76);
            border: 1px solid #393246;
            border-radius: 13px;
            cursor: pointer;
            transition: color 0.2s ease, background 0.2s ease,
                border-color 0.2s ease, transform 0.2s ease;
        }

        .suggestion i {
            color: var(--accent-light);
            font-size: 15px;
        }

        .suggestion:hover {
            color: #fff;
            background: #2b2539;
            border-color: #7860c6;
            transform: translateY(-2px);
        }

        .menu-item:focus-visible,
        .history-item:focus-visible,
        .icons-button:focus-visible,
        .prompt-icon:focus-visible,
        .send-button:focus-visible,
        .suggestion:focus-visible {
            outline: 2px solid var(--accent-light);
            outline-offset: 3px;
        }

        /* Tablets e celulares */
        @media (max-width: 768px) {
            :root {
                --sidebar-width: 260px;
            }

            .sidebar {
                width: var(--sidebar-width);
                transform: translateX(-105%);
                box-shadow: 15px 0 45px rgba(0, 0, 0, 0.32);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            main {
                width: 100%;
                margin-left: 0;
            }

            .configbar {
                z-index: 1200;
                inset: 0 0 0 auto;
                width: min(320px, 88vw);
                border-right: 0;
                border-left: 1px solid var(--border);
            }

            .chat-area {
                padding: 28px 22px 48px;
            }

            .titulo {
                margin-bottom: 28px;
                font-size: clamp(27px, 5vw, 35px);
            }

            main::before {
                width: 100%;
                height: 440px;
            }
        }

        @media (max-width: 480px) {
            .sidebar {
                width: min(290px, 86vw);
            }

            .chat-area {
                padding: 22px 15px 35px;
            }

            .titulo {
                margin-bottom: 24px;
                font-size: clamp(25px, 7vw, 30px);
                letter-spacing: -0.8px;
            }

            .prompt-box {
                min-height: 60px;
                gap: 6px;
                padding: 8px;
                border-radius: 18px;
            }

            .prompt-icon {
                flex-basis: 34px;
                width: 34px;
                height: 34px;
                font-size: 20px;
            }

            .prompt-input {
                padding: 10px 0;
                font-size: 13px;
            }

            .send-button {
                flex-basis: 38px;
                width: 38px;
                height: 38px;
                border-radius: 12px;
            }

            .prompt-hint {
                font-size: 10px;
            }

            .suggestions {
                gap: 8px;
                margin-top: 22px;
            }

            .suggestion {
                min-height: 40px;
                padding: 9px 11px;
                font-size: 11px;
                border-radius: 12px;
            }
        }

        @media (max-height: 620px) and (min-width: 769px) {
            .chat-area {
                padding-top: 20px;
                padding-bottom: 20px;
            }

            .titulo {
                margin-bottom: 22px;
                font-size: 32px;
            }

            .suggestions {
                margin-top: 18px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>

    <!-- Barra lateral -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-header">

            <div class="logo">
                <div class="imagem-container">
                    <img src="/imgs/docscode_logo.png" alt="Logo DocsCode">
                </div>
                <span>DocsCode AI</span>
            </div>

            <button class="icons-button" title="Configurações">
                <i class="bi bi-search"></i>
            </button>

        </div>


        <!-- Menu principal -->
        <nav class="menu">

            <a href="#" class="menu-item">
                <i class="bi bi-pencil-square"></i>
                <span>Nova conversa</span>
            </a>

            <a href="#" class="menu-item">
                <i class="bi bi-grid"></i>
                <span>Biblioteca</span>
            </a>

        </nav>


        <!-- Histórico -->
        <div class="history-header">
            <span class="section-label">Histórico</span>
        </div>

        <a href="#" class="history-item">
            <i>Inicie uma conversa</i>
        </a>


        <!-- Perfil -->
        <div class="sidebar-footer">

            <div class="avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="profile-info">
                <div class="profile-name"><%= username %></div>
                <div class="profile-plan">Plano Gratuito</div>
            </div>

            <button class="icons-button" id="configButton" title="Configurações">
                <i class="bi bi-gear"></i>
            </button>

        </div>

    </aside>

    <!-- Barra lateral de configurações (inicialmente oculta) -->
    <aside hidden id="configbar" class="configbar">

        <div class="configbar-header">
            <h2>Configurações</h2>

            <button
                class="icons-button"
                title="Fechar configurações"
                onclick="document.getElementById('configbar').hidden = true;" >

                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="configbar-content">
            
            <div class="configbar-item form-check form-switch">
                <label>Modo Escuro</label>
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            </div>

            <button class="configbar-item" id="logoutButton">Sair da Conta</button>

        </div>

        

    </aside>

    <!-- Área principal -->
    <main>

        <!-- Conteúdo central -->
        <section class="chat-area">

            <h1 class="titulo">Compartilhe Tuas Ideias Comigo.</h1>

            <div class="prompt-container">

                <form class="prompt-box" id="chatForm">

                    <button type="button" class="prompt-icon"
                            title="Adicionar arquivo">
                        <i class="bi bi-plus-lg"></i>
                    </button>

                    <input
                        type="text"
                        class="prompt-input"
                        id="promptInput"
                        placeholder="Peça algo à DocsCode AI..."
                        autocomplete="off"
                    >

                    <button type="submit" class="send-button"
                            id="sendButton" title="Enviar mensagem">
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <p class="prompt-hint">
                    A IA pode falhar ou gerar informações incorretas.
                </p>

            </div>

            <!-- Sugestões -->
            <div class="suggestions">

                <button class="suggestion" data-prompt="Me ajude a programar">
                    <i class="bi bi-code-slash"></i>
                    Programar
                </button>

                <button class="suggestion" data-prompt="Me ajude a produzir um documento">
                    <i class="bi bi-book"></i>
                    Documentar
                </button>

                <button class="suggestion" data-prompt="Me explique este">
                    <i class="bi bi-lightbulb"></i>
                    Explicar
                </button>

            </div>

        </section>

    </main>

    <script>

        const sidebar = document.getElementById('sidebar');
        const configbar = document.getElementById('configbar');
        const configButton = document.getElementById('configButton');
        configButton.addEventListener('click', () => {
            configbar.hidden = !configbar.hidden;
        });

        const logoutButton = document.getElementById('logoutButton');
        logoutButton.addEventListener('click', deslogarUsuario);

        async function deslogarUsuario(e)
        {
            e.preventDefault();

            req.session.destroy((erro) => {
                if (erro) {
                    console.error(erro);
                    return res.status(500).json({
                        mensagem: "Não foi possível encerrar a sessão."
                    });
                }
                req.session.usuarioLogado = false;
                return res.render('/', { mensagem: "Logout realizado com sucesso!" });
            });

        }

        const promptInput = document.getElementById('promptInput');
        const sendButton = document.getElementById('sendButton');
        const chatForm = document.getElementById('chatForm');
        
        // Mostrar o botão de envio quando houver texto
        promptInput.addEventListener('input', () => {
            sendButton.style.display =
            promptInput.value.trim() ? 'flex' : 'none';
        });

        // Preencher o campo pelas sugestões
        document.querySelectorAll('.suggestion').forEach(button => {
            button.addEventListener('click', () => {
                promptInput.value = button.dataset.prompt;
                promptInput.dispatchEvent(new Event('input'));
                promptInput.focus();
            });
        });

        // Envio demonstrativo
        chatForm.addEventListener('submit', event => {
            event.preventDefault();

            const mensagem = promptInput.value.trim();

            if (!mensagem) return;

            alert(
                'Mensagem: ' + mensagem +
                '\n\nConecte uma API de IA para receber respostas.'
            );

            promptInput.value = '';
            promptInput.dispatchEvent(new Event('input'));
        });

    </script>

</body>
</html>
